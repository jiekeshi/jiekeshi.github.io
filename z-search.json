---
layout: null
---
[
  {% assign all_items = site.posts | concat: site.pages %}
  {% assign filtered_items = "" | split: "" %}

  {% for item in all_items %}
    {% if item.title and item.url != "/z-search.json" and item.url != "/search.json" %}
      {% assign filtered_items = filtered_items | push: item %}
    {% endif %}
  {% endfor %}

  {% for item in filtered_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "content": {{ item.content | markdownify | strip_html | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]